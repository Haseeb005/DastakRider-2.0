# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
#
# The local script already sets defaults for everything below EXCEPT
# MONGODB_URI_RIDER, which you must provide.

MONGODB_URI_RIDER=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Optional overrides (defaults are fine for local dev):
# SESSION_SECRET=local-dev-secret
# PORT=3000
# NODE_ENV=development
